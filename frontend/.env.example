# URL base da API.
#
# Deixe VAZIO (ou não defina) para usar a mesma origem do app — é o padrão e
# funciona tanto em produção (Vercel serve app e API no mesmo domínio) quanto
# em desenvolvimento (o Vite faz proxy de /api para o backend local).
#
# Só preencha para apontar o app para uma API em outro endereço, ex.:
# VITE_API_URL=https://contabilis-api.exemplo.com/api
VITE_API_URL=

# Endereço do backend para o proxy do Vite em desenvolvimento.
# Padrão: http://localhost:3333
# API_PROXY_TARGET=http://localhost:3333
