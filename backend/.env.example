# Porta da API (desenvolvimento; no Vercel a porta é da plataforma)
PORT=3333

# Conexão PostgreSQL.
# Local: mesmo do docker-compose.yml na raiz.
# Produção (Neon): use a connection string POOLED — o host termina em "-pooler":
#   postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/contabilis?sslmode=require
DATABASE_URL=postgres://contabilis:contabilis@localhost:5432/contabilis

# Segredo que assina os JWT da sessão.
# OBRIGATÓRIO em produção — gere um valor próprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=dev-secret-nao-usar-em-producao
JWT_EXPIRES_IN=8h

# Chave AES-256-GCM (32 bytes em base64) que cifra as credenciais dos portais.
# OBRIGATÓRIA em produção — e imutável depois do primeiro uso: trocá-la torna
# ilegíveis todas as senhas já gravadas. Gere com o mesmo comando acima.
CREDENTIALS_ENCRYPTION_KEY=Y29udGFiaWxpcy1kZXYta2V5LTMyLWJ5dGVzLWFhYWE=

# Origens externas liberadas no CORS, separadas por vírgula. No deploy único
# (frontend e API no mesmo domínio) pode ficar vazio. Em desenvolvimento
# qualquer localhost já é liberado automaticamente.
CORS_ORIGIN=

# Usuários para o `npm run seed:usuarios`, como alternativa ao arquivo
# backend/usuarios.json. JSON em uma linha — veja usuarios.example.json.
# USUARIOS_SEED=[{"username":"gisele","nome":"Gisele","email":"gisele@contabilis.net"}]
