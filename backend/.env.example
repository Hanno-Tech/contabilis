# Porta da API
PORT=3333

# Conexão PostgreSQL (mesmo do docker-compose.yml na raiz)
DATABASE_URL=postgres://contabilis:contabilis@localhost:5432/contabilis

# Segredo para assinar os JWT da sessão
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Chave AES-256-GCM (32 bytes em base64) usada para cifrar credenciais sensíveis.
# Gere uma nova com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=Y29udGFiaWxpcy1kZXYta2V5LTMyLWJ5dGVzLWFhYWE=

# Origens permitidas no CORS (frontend). Várias separadas por vírgula.
# O alias http://contabilis.local é o endereço padrão do app.
CORS_ORIGIN=http://contabilis.local,http://localhost:5173
